# Vorlage. Kopieren nach android/keystore.properties und ausfuellen.
# Die echte Datei ist in .gitignore — sie enthaelt Passwoerter.
#
# storeFile darf absolut sein und sollte ausserhalb des Projektordners
# liegen: so nimmt ein ZIP oder ein versehentliches "git add -f" den
# Schluessel nicht mit.
storeFile=/pfad/zu/openeos-release.p12
storePassword=
keyAlias=openeos
keyPassword=
